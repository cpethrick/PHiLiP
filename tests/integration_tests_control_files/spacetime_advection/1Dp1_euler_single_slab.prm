# -------------------

set run_type = flow_simulation
#set test_type = general_h_refinement_study

# Number of SPATIAL dimensions
set dimension = 1
# Number of TEMPORAL dimensions
set temporal_dimension = 1

set use_weak_form = false

set overintegration = 0

set flux_nodes_type = GLL

set use_split_form = true

set use_inverse_mass_on_the_fly = false

# The PDE we want to solve
set pde_type = euler

set two_point_num_flux_type = Ra
set conv_num_flux = two_point_flux_with_entropy_stable_matrix_dissipation
#set conv_num_flux = upwind
#
#
set flux_reconstruction = user_specified_value
set FR_user_specified_correction_parameter_value = 0
#set output_face_results_vtk = true

subsection ODE solver

  set ode_output = quiet
  
  #set nonlinear_max_iterations = 500
  set nonlinear_max_iterations = 50000
  #set nonlinear_max_iterations = 500
  set nonlinear_steady_residual_tolerance = 1E-12

  #set print_iteration_modulo = 100
  set print_iteration_modulo = 1

  set ode_solver_type = implicit
  #set ode_solver_type = runge_kutta

  set output_solution_every_x_steps = 1
  set initial_time_step = 1
  set runge_kutta_method = euler_ex
end

subsection linear solver
  set linear_solver_output = quiet
  subsection gmres options
    set linear_residual_tolerance = 1E-7
    set ilut_atol = 1E-7
  end
end

subsection manufactured solution convergence study
  set use_manufactured_source_term = true
  #set manufactured_solution_type = euler_spacetime
end

subsection time_refinement_study
  set number_of_times_to_solve = 1
  set refinement_ratio = 0.5
end
subsection flow_solver
    set flow_case_type = spacetime_cartesian
    #set steady_state = true
    set is_decoupled_spacetime = true
    set poly_degree = 4
    set constant_time_step = 0.5
    subsection grid
      set use_gmsh_mesh = true
      set input_mesh_filename = ../../meshes/slab2D_extracoarse
      subsection gmsh_boundary_IDs
        set use_periodic_BC_in_x = true
        set x_periodic_id_face_1 = 2003
        set x_periodic_id_face_2 = 2004
      end
      #set grid_left_bound = 0.0
      #set grid_right_bound = 2.0
      #set number_of_grid_elements_per_dimension = 16
    end
    set final_time = 2.0
end

