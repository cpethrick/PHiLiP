# Listing of Parameters
# ---------------------
# Number of dimensions

set dimension = 1
set run_type = integration_test
set test_type = general_h_refinement_study
set pde_type = euler

# DG formulation
set use_weak_form = false
set use_split_form = true
set flux_nodes_type = GLL

set flux_reconstruction = cDG
set use_inverse_mass_on_the_fly = true

set all_boundaries_are_periodic = true
set check_same_coords_in_weak_dg = false

# numerical fluxes
set conv_num_flux = two_point_flux_with_l2roe_dissipation
set two_point_num_flux_type = Ra

# ODE solver
subsection ODE solver
  set ode_output = quiet 
  set ode_solver_type = runge_kutta 
  set runge_kutta_method = rk4_ex
  set initial_time_step = 0.01
  #set output_solution_every_x_steps = 1
end

subsection linear solver
  set linear_solver_output = quiet
end

subsection manufactured solution convergence study
  set use_manufactured_source_term = true
  #set manufactured_solution_type = euler_spacetime
end

subsection time_refinement_study
  set number_of_times_to_solve = 4
  set refinement_ratio = 0.5
end

subsection flow_solver
  set flow_case_type = euler_manufactured_MoL
  set poly_degree = 3
  set final_time = 2.0
  set courant_friedrichs_lewy_number = 0.1
  #set courant_friedrichs_lewy_number = 0.1
  #set constant_time_step_size = 0.001
  set unsteady_data_table_filename = isentropic_vortex_time_table
  subsection grid
    set grid_left_bound = 0.0
    set grid_right_bound = 2.0
    set number_of_grid_elements_per_dimension = 8
  end
end
