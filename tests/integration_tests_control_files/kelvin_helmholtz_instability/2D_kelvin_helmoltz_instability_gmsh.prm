# Listing of Parameters
# ---------------------
# Number of dimensions

set dimension = 2 
set run_type = flow_simulation
set pde_type = euler

# DG formulation
set use_weak_form = false
set use_split_form = true
set flux_nodes_type = GL

set flux_reconstruction = cDG
set use_inverse_mass_on_the_fly = true

set all_boundaries_are_periodic = true
set check_same_coords_in_weak_dg = false

# numerical fluxes
set conv_num_flux = two_point_flux_with_lax_friedrichs_dissipation
set two_point_num_flux_type = Ra

# ODE solver
subsection ODE solver
  set ode_output = verbose 
  set ode_solver_type = runge_kutta
  set runge_kutta_method = dirk_2_im
  #set ode_solver_type = low_storage_runge_kutta
  #set runge_kutta_method = RK3_2_5F_3SStarPlus
  #subsection low-storage rk solver
  #  set atol = 1E-7
  #  set rtol = 1E-7
  #end
  set solver_type_for_diagonally_implicit_RK = AD
end

subsection linear solver
  set linear_solver_output = quiet
end

subsection flow_solver
  set flow_case_type = kelvin_helmholtz_instability
  #set poly_degree = 7 # To match Chan 2022 Fig. 7 b
  set poly_degree = 3 # For faster run time during ctest
  set final_time = 10
  set courant_friedrichs_lewy_number = 10
  set unsteady_data_table_filename = khi_time_table
  #set error_adaptive_time_step = true
  subsection grid
    set use_gmsh_mesh = true
    set input_mesh_filename = ../../meshes/mesh_2D_structured_coarse
    
      subsection gmsh_boundary_IDs
        set use_periodic_BC_in_x = true # default IDs are used
        set use_periodic_BC_in_y = true # default IDs are used
      end
    #set grid_left_bound = -1.0
    #set grid_right_bound = 1.0
    #set number_of_grid_elements_per_dimension = 16
  end
  subsection kelvin_helmholtz_instability
    set atwood_number = 0.333333333333333333333333333333
  end
end
